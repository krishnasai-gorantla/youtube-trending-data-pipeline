{
  "Comment": "End-to-end YouTube Trending batch pipeline: raw CSVs -> staged Parquet -> curated safe/quarantine Parquet.",
  "StartAt": "AssignRunId",
  "States": {
    "AssignRunId": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "States.UUID()",
        "input.$": "$"
      },
      "Next": "StageRawCSVs"
    },
    "StageRawCSVs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "youtube-pipeline-staging-v1",
        "Arguments": {
          "--RUN_ID.$": "$.run_id"
        }
      },
      "ResultPath": "$.staging",
      "Next": "StartStagingCrawler"
    },
    "StartStagingCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-staging-crawler"
      },
      "ResultPath": null,
      "Next": "WaitForStagingCrawler"
    },
    "WaitForStagingCrawler": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "CheckStagingCrawler"
    },
    "CheckStagingCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-staging-crawler"
      },
      "ResultPath": "$.crawler",
      "Next": "StagingCrawlerReady"
    },
    "StagingCrawlerReady": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.crawler.Crawler.LastCrawl.Status",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "CurateAndQuarantine"
        },
        {
          "And": [
            {
              "Variable": "$.crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.crawler.Crawler.LastCrawl.Status",
              "StringEquals": "FAILED"
            }
          ],
          "Next": "StagingCrawlerFailed"
        }
      ],
      "Default": "WaitForStagingCrawler"
    },
    "CurateAndQuarantine": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "youtube-pipeline-curation-v1",
        "Arguments": {
          "--RUN_ID.$": "$.run_id"
        }
      },
      "ResultPath": "$.curation",
      "Next": "StartSafeCrawler"
    },
    "StartSafeCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-safe-crawler"
      },
      "ResultPath": null,
      "Next": "WaitForSafeCrawler"
    },
    "WaitForSafeCrawler": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "CheckSafeCrawler"
    },
    "CheckSafeCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-safe-crawler"
      },
      "ResultPath": "$.safe_crawler",
      "Next": "SafeCrawlerReady"
    },
    "SafeCrawlerReady": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.safe_crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.safe_crawler.Crawler.LastCrawl.Status",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "StartQuarantineCrawler"
        },
        {
          "And": [
            {
              "Variable": "$.safe_crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.safe_crawler.Crawler.LastCrawl.Status",
              "StringEquals": "FAILED"
            }
          ],
          "Next": "SafeCrawlerFailed"
        }
      ],
      "Default": "WaitForSafeCrawler"
    },
    "StartQuarantineCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-quarantine-crawler"
      },
      "ResultPath": null,
      "Next": "WaitForQuarantineCrawler"
    },
    "WaitForQuarantineCrawler": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "CheckQuarantineCrawler"
    },
    "CheckQuarantineCrawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:getCrawler",
      "Parameters": {
        "Name": "youtube-pipeline-quarantine-crawler"
      },
      "ResultPath": "$.quarantine_crawler",
      "Next": "QuarantineCrawlerReady"
    },
    "QuarantineCrawlerReady": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.quarantine_crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.quarantine_crawler.Crawler.LastCrawl.Status",
              "StringEquals": "SUCCEEDED"
            }
          ],
          "Next": "PipelineSucceeded"
        },
        {
          "And": [
            {
              "Variable": "$.quarantine_crawler.Crawler.State",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.quarantine_crawler.Crawler.LastCrawl.Status",
              "StringEquals": "FAILED"
            }
          ],
          "Next": "QuarantineCrawlerFailed"
        }
      ],
      "Default": "WaitForQuarantineCrawler"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "StagingCrawlerFailed": {
      "Type": "Fail",
      "Error": "StagingCrawlerFailed",
      "Cause": "Glue crawler failed to register staging partitions."
    },
    "SafeCrawlerFailed": {
      "Type": "Fail",
      "Error": "SafeCrawlerFailed",
      "Cause": "Glue crawler failed to register safe curated partitions."
    },
    "QuarantineCrawlerFailed": {
      "Type": "Fail",
      "Error": "QuarantineCrawlerFailed",
      "Cause": "Glue crawler failed to register quarantine partitions."
    }
  },
  "TimeoutSeconds": 7200
}
